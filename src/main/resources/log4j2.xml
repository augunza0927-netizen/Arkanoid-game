<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="ConsoleAppender" target="SYSTEM_OUT">
            <ThresholdFilter level="DEBUG" onMatch="ACCEPT" onMismatch="DENY"/>
            <PatternLayout pattern="[%d{HH:mm:ss.SSS}] [%-5level] [%t] %c{1} - %msg%n"/>
        </Console>
        <File name="FileAppender" fileName="logs/game.log" append="true">
            <PatternLayout pattern="[%d{yyyy-MM-dd HH:mm:ss.SSS}] [%-5level] [%t] %c - %msg%n"/>
        </File>
    </Appenders>

    <Loggers>
        <!-- TRACE, DEBUG, INFO, WARN, ERROR -->
        <Logger name="se233.project2" level="TRACE" additivity="false">
            <AppenderRef ref="ConsoleAppender"/>
            <AppenderRef ref="FileAppender"/>
        </Logger>

        <Root level="INFO">
            <AppenderRef ref="ConsoleAppender"/>
        </Root>
    </Loggers>
</Configuration>
